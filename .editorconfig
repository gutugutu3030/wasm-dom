# 整形設定（**IDE / エディタ / ktlint CLI 向け**）。
#
# **spotless にはここを読ませない**（親 Konpetomoide で実測済）:
# - 置くだけでは読まれない（折返し設定を書いても 209 字の 1 行が直らなかった）
# - `setEditorConfigPath` で読ませると全ファイルが
#   `NoClassDefFoundError: com/pinterest/ktlint/rule/engine/api/EditorConfigDefaults` になった
#
# **効く側は `build.gradle.kts` の `editorConfigOverride`**。ルールを変えるときはここも同じ値に
# 揃える（ズレると IDE 整形が spotless に勝つ）。**親の同名ファイルとも同じ値**にしておく
# （`agents.md`「フォーマット規則」）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
tab_width = 4
continuation_indent_size = 4

# ↓ `build.gradle.kts` の `ktlintRules` と同じ値
# 既存コードの書き方（`fun f() = 式` を同じ行に置く）に合わせる
ktlint_code_style = intellij_idea
# intellij_idea の既定は式ボディをどれだけ長くても 1 行に畳む（実測で 209 字行が自動生成された）
ktlint_function_signature_body_expression_wrapping = always
# 日本語コメントが 140 字を超えるのが普通なので行長検査は入れない。
# **`off` ではなく `-1`**（`build.gradle.kts` の `ktlintRules` と同じ値）: ktlint はどちらも無効として
# 見るが、**IDE はこの値を int で読む**ので `off` は解釈されない可能性がある
max_line_length = -1
